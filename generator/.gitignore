# Ключи и локальные настройки — НИКОГДА не коммитить.
# Шаблон без ключей лежит в .env.example, его коммитить можно.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Локальные настройки редакторов и Claude Code
.claude/settings.local.json
.vscode/
.idea/

# Результаты работы программы
*.log
out/

# Журнал вызовов модели: видны параметры прогонов и куски ответов пользователя
logs/
.pytest_cache/
