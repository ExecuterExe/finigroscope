# Шаблон настроек. Скопируйте в .env и впишите свой ключ.
#   Windows:  copy .env.example .env
# Файл .env закрыт .gitignore и на GitHub не попадёт. Этот файл — попадёт,
# поэтому НИКОГДА не вписывайте настоящий ключ сюда.

LLM_PROVIDER=openrouter

# Ключ берётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модели. В документе к проекту заложено разделение:
#   PRO   — генерация (нужно качество)
#   FLASH — проверки и аудит (нужны дёшево и быстро)
# Список моделей и цены: https://openrouter.ai/models
OPENROUTER_MODEL_PRO=deepseek/deepseek-chat
OPENROUTER_MODEL_FLASH=deepseek/deepseek-chat

# Рассуждающая модель. Нужна проходам аудита story и features: там идёт
# семантическая сверка («жетон» и «фишка» — это один предмет или разные?), а
# обычная чат-модель рассуждать не умеет и флаг thinking на ней не сработает.
# Пока строка пустая — эти проходы идут на OPENROUTER_MODEL_PRO без рассуждений.
# Пример значения: deepseek/deepseek-r1
OPENROUTER_MODEL_REASONING=

# Необязательное: OpenRouter показывает это в рейтингах приложений
OPENROUTER_APP_TITLE=Generator igr
OPENROUTER_APP_URL=http://localhost:8000

# Куда ведёт кнопка «ФинИгроСкоп» в шапке страницы. В разработке это соседний
# порт, на сервере — корень домена за тем же nginx (см. deploy/).
#   разработка: http://localhost:5000
#   сервер:     /
FINIGROSKOP_URL=http://localhost:5000

# --- разработка ---------------------------------------------------------------
# Перезапускать сервер при правке .py (как это делает Flask у ФинИгроСкопа).
# Без этого правка маршрута не доезжает до работающего процесса, а страницу
# браузер перечитывает сам — получается «новая страница + старый сервер», и она
# отвечает «сервер не знает адрес» на маршрут, который в коде есть.
# На сервере не нужно: там процессом управляет systemd.
# GENERATOR_AUTORELOAD=1


# --- оценка по линзам Шелла (агент живёт в ФинИгроСкопе) ---------------------
# После аудита модуль уходит на оценку по линзам. Адрес нужен СЕРВЕРУ, а не
# браузеру, поэтому он полный даже там, где FINIGROSKOP_URL — это «/».
LENS_API_URL=http://127.0.0.1:5000
# Общий секрет с ФинИгроСкопом: тот же LENS_API_TOKEN в его .env. Вызов линз
# тратит деньги на модель, поэтому на сервере без секрета он не работает.
LENS_API_TOKEN=
# Сколько секунд ждать оценку (агенту линз отведено 300 с на вызов модели).
LENS_TIMEOUT=330
# Сколько ждать ОТДЕЛЬНОГО http-запроса к ФинИгроСкопу — не оценки целиком.
# По умолчанию 20 с локально и 90 с на хостинге: там спящий сервис просыпается
# около минуты, и первый вызов после простоя иначе падал бы всегда.
# LENS_HTTP_TIMEOUT=20

# Ограничители запроса
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7


# --- где слушать --------------------------------------------------------------
# Обе переменные НЕОБЯЗАТЕЛЬНЫ и нужны только на хостинге.
#
# PORT задаёт платформа (Render, Railway и подобные) и требует слушать именно
# его. По наличию этой переменной сервис понимает, что запущен не на машине
# разработчика, и меняет два умолчания: слушает 0.0.0.0 вместо 127.0.0.1 и не
# поднимает сторож автоперезагрузки. Оба перебиваются явным значением.
#
# HOST на машине разработчика по умолчанию 127.0.0.1 — сервер разработки не
# должен без спроса выходить в сеть.
# HOST=0.0.0.0
# PORT=8000
