# Шаблон настроек. Скопируйте в .env и впишите свой ключ.
#   Windows:  copy .env.example .env
# Файл .env закрыт .gitignore и на GitHub не попадёт. Этот файл — попадёт,
# поэтому НИКОГДА не вписывайте настоящий ключ сюда.

LLM_PROVIDER=openrouter

# Ключ берётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модели. В документе к проекту заложено разделение:
#   PRO   — генерация (нужно качество)
#   FLASH — проверки и аудит (нужны дёшево и быстро)
# Список моделей и цены: https://openrouter.ai/models
OPENROUTER_MODEL_PRO=deepseek/deepseek-chat
OPENROUTER_MODEL_FLASH=deepseek/deepseek-chat

# Рассуждающая модель. Нужна проходам аудита story и features: там идёт
# семантическая сверка («жетон» и «фишка» — это один предмет или разные?), а
# обычная чат-модель рассуждать не умеет и флаг thinking на ней не сработает.
# Пока строка пустая — эти проходы идут на OPENROUTER_MODEL_PRO без рассуждений.
# Пример значения: deepseek/deepseek-r1
OPENROUTER_MODEL_REASONING=

# Необязательное: OpenRouter показывает это в рейтингах приложений
OPENROUTER_APP_TITLE=Generator igr
OPENROUTER_APP_URL=http://localhost:8000

# Куда ведёт кнопка «ФинИгроСкоп» в шапке страницы. В разработке это соседний
# порт, на сервере — корень домена за тем же nginx (см. deploy/).
#   разработка: http://localhost:5000
#   сервер:     /
FINIGROSKOP_URL=http://localhost:5000

# Ограничители запроса
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
