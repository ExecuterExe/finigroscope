# Скопируйте этот файл в .env (в этой же папке) и впишите свои значения.
# .env читается автоматически при старте app.py (load_dotenv()) и в git не попадает.

# Какой LLM-провайдер использовать: "openrouter" или "gemini".
# Без этой строки (или при любом другом значении) агенты работают в режиме
# "ИИ недоступен" — сервис не падает, просто не даёт ИИ-ответов.
LLM_PROVIDER=openrouter

# --- OpenRouter (рекомендуется) ---------------------------------------------
# Один ключ — доступ к десяткам моделей (в т.ч. бесплатным) через один шлюз.
# Ключ получить:
#   1) откройте https://openrouter.ai/keys
#   2) войдите (можно через Google/GitHub)
#   3) "Create Key", скопируйте значение
#   4) вставьте его сюда вместо REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

# Необязательно: какая модель. Если строку НЕ раскомментировать — провайдер
# сам переберёт несколько проверенных бесплатных моделей при перегрузке (429)
# или недоступности одной из них, так что вручную обычно ничего подбирать не
# надо. Раскомментируйте только если хотите ЗАКРЕПИТЬ конкретную модель
# (тогда автопереключение отключается — уважаем явный выбор):
#   python tests/openrouter_list_models.py   # актуальный список бесплатных
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Gemini (альтернатива) ---------------------------------------------------
# Раскомментируйте LLM_PROVIDER=gemini выше и эти строки, если хотите Gemini
# вместо OpenRouter.
# GEMINI_API_KEY=REPLACE_ME
# Ключ: https://aistudio.google.com/apikey (вход через Google-аккаунт, карта не нужна)
# Модель по умолчанию — "gemini-flash-latest" (плавающий алиас). Если что-то
# не работает — узнайте, что доступно вашему ключу: python tests/gemini_list_models.py
# GEMINI_MODEL=gemini-flash-latest
