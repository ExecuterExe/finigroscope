# Скопируйте этот файл в .env (в этой же папке) и впишите свои значения.
# .env читается автоматически при старте app.py (load_dotenv()) и в git не попадает.
#
# ВАЖНО: ключи можно держать сразу у НЕСКОЛЬКИХ вендоров, а переключаться между
# ними на странице «Настройки ИИ» (ссылка 🧠 в шапке сайта) — без перезапуска и
# без правки этого файла. Это спасает, когда у одного вендора кончилась квота.
# Значение LLM_PROVIDER ниже — лишь провайдер ПО УМОЛЧАНИЮ для этой установки.

# --- какой провайдер использовать по умолчанию -------------------------------
# Варианты: openrouter | gemini | xai | deepseek | anthropic | openai | groq |
#           custom | null
# При значении null (или неизвестном) агенты работают в режиме «ИИ недоступен» —
# сервис не падает, просто не даёт ИИ-ответов.
LLM_PROVIDER=openrouter

# Необязательно: сколько секунд ждать ответа модели (по умолчанию 25).
# Сервер разработки Flask однопоточный: пока модель думает, другие страницы
# тоже ждут, поэтому таймаут намеренно короткий.
# LLM_TIMEOUT=25

# Только для тестов/CI: жёстко фиксирует провайдера и ИГНОРИРУЕТ выбор,
# сделанный в интерфейсе. В обычной работе не задавайте.
# LLM_PROVIDER_FORCE=null


# --- OpenRouter (рекомендуется для старта) -----------------------------------
# Один ключ — доступ к десяткам моделей (в т.ч. бесплатным) через один шлюз.
# Ключ получить:
#   1) откройте https://openrouter.ai/keys
#   2) войдите (можно через Google/GitHub)
#   3) "Create Key", скопируйте значение
#   4) вставьте его сюда вместо REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

# Необязательно: закрепить модель. Если строку НЕ раскомментировать — провайдер
# сам переберёт несколько бесплатных моделей при перегрузке (429) или
# недоступности одной из них, а последней ступенью пойдёт служебный роутер
# openrouter/free, который работает даже когда конкретные имена сменились.
# Раскомментируйте, только если хотите ЗАКРЕПИТЬ конкретную модель (тогда
# автопереключение отключается — уважаем явный выбор). Актуальный список:
#   python tests/llm_list_models.py openrouter
# OPENROUTER_MODEL=


# --- Google Gemini -----------------------------------------------------------
# Ключ: https://aistudio.google.com/apikey (вход через Google-аккаунт, карта не нужна)
# GEMINI_API_KEY=REPLACE_ME
# Модель по умолчанию — "gemini-flash-latest" (плавающий алиас, Google обновляет
# его сам). Если что-то не работает — узнайте, что доступно вашему ключу:
#   python tests/gemini_list_models.py
# GEMINI_MODEL=gemini-flash-latest


# --- xAI Grok ----------------------------------------------------------------
# Ключ: https://console.x.ai  (оплата по токенам, бесплатного тарифа нет)
# XAI_API_KEY=REPLACE_ME
# XAI_MODEL=grok-4.5


# --- DeepSeek ----------------------------------------------------------------
# Дёшево и сильна в коде — именно её рекомендует промпт агента-симуляциониста.
# Ключ: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=REPLACE_ME
# DEEPSEEK_MODEL=deepseek-v4-pro


# --- Anthropic Claude --------------------------------------------------------
# Ключ: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=REPLACE_ME
# ANTHROPIC_MODEL=claude-sonnet-5


# --- OpenAI ------------------------------------------------------------------
# Ключ: https://platform.openai.com/api-keys
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_MODEL=gpt-5.6


# --- Groq (очень быстрый, есть бесплатный тариф) ------------------------------
# Ключ: https://console.groq.com/keys
# Модель ОБЯЗАТЕЛЬНО указать самим: каталог Groq часто меняется, поэтому в коде
# нет модели по умолчанию. Посмотреть живой список:
#   python tests/llm_list_models.py groq
# GROQ_API_KEY=REPLACE_ME
# GROQ_MODEL=


# --- Свой OpenAI-совместимый сервер (Ollama, LM Studio, vLLM, прокси) ---------
# Например локальная Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
# Сюда же можно подключить OpenAI-совместимый эндпоинт Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<ключ Gemini>
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
